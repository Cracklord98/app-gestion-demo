PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL local alternate port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_gestion_demo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_gestion_demo?schema=public"

# Demo auth for local development.
AUTH_ENABLED=false
AUTH_DEMO_BYPASS=true
ADMIN_EMAIL=admin@synaptica.local

# Only needed when testing Microsoft Entra auth.
AZURE_AD_TENANT_ID=common
AZURE_AD_AUDIENCE=api://app-gestion-backend
